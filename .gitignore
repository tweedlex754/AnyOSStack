# Dependencies
node_modules/

# Build output (packaged installers/apps)
release/
dist/
out/

# Generated at build time by scripts/build-icons.js from build/icon-master.svg.
# The SOURCE (icon-master.svg) is committed; these derived binaries are not.
build/icon.ico
build/icon.icns
build/icon.png
build/icons/
build/installerIcon.ico
build/installerHeaderIcon.ico
build/uninstallerIcon.ico
build/installerSidebar.bmp
build/installerHeader.bmp
build/dmg-background.png
build/_*.png

# Generated at build time by scripts/build-installer-lang.js. `npm run prebuild`
# recreates all three and CI runs prebuild before every build, so a clone never
# needs them committed.
build/installer.nsh
build/linux-desktop.yml
build/anyosstack-languages.nsh

# Generated by scripts/generate-installer-ui.py, which scripts/build-win-installer.js
# invokes itself on the local `dist:win-local` path. CI never needs them: the
# normal electron-builder path draws its own installer chrome.
build/installer-ui/

# Logs / OS cruft
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# The renderer app (src/renderer/index.html) IS committed - it is the app's
# source of truth. scripts/build-renderer.js only exists to regenerate it from
# the original standalone web app for maintainers who have that reference file.
