; AnyOSStack — Stitch-inspired custom NSIS installer.
; The static visual shell is rendered as 24-bit bitmaps by
; scripts/generate-installer-ui.js. All fields, buttons, progress reporting,
; installation and uninstall behavior remain real native NSIS controls.
;
; Every visible sentence is a native label fed by a LangString from
; build/anyosstack-languages.nsh (generated by scripts/build-installer-lang.js),
; so picking a language in the startup dialog translates the whole wizard - not
; only the navigation buttons. The bitmaps carry chrome only.

Unicode true
ManifestDPIAware true
; zlib keeps local rebuilds practical while still producing a single compact EXE.
SetCompressor /SOLID zlib

!include "FileFunc.nsh"
!include "LogicLib.nsh"
!include "nsDialogs.nsh"
!include "WinMessages.nsh"

!define APP_NAME       "AnyOSStack"
!ifndef APP_VERSION
  !define APP_VERSION "2.0.0"
!endif
!define APP_EXE        "AnyOSStack.exe"
!define APP_PUBLISHER  "AnyOSStack contributors"
!define APP_URL        "https://github.com/tweedlex754/AnyOSStack"
!define UNINST_KEY     "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APP_NAME}"

!define BUILD "${__FILEDIR__}"
!define PROJ  "${__FILEDIR__}\.."

!ifndef SRC
  !define SRC "${PROJ}\release\win-unpacked"
!endif
!ifndef UI_ASSETS
  !define UI_ASSETS "${BUILD}\installer-ui"
!endif
!ifndef OUTPUT_DIR
  !define OUTPUT_DIR "${PROJ}\release"
!endif
!ifndef SETUP_ICON
  ; The brand .ico produced by scripts/build-icons.js. Never point this at a file
  ; inside ${SRC}: anything added there ends up shipped inside the app folder.
  !define SETUP_ICON "${BUILD}\icon.ico"
!endif

!define COLOR_BG       "131313"
!define COLOR_BLACK    "0E0E0E"
!define COLOR_INK      "E5E2E1"
!define COLOR_MUTED    "A9928C"
!define COLOR_ORANGE   "FF5722"
!define COLOR_SURFACE  "242323"
!define COLOR_SIDEBAR  "1C1B1B"
!define COLOR_CARD     "1D1D1D"
!define COLOR_LIGHT    "FFB5A0"
!define COLOR_CYAN     "BDF4FF"

; SS_CENTER already comes from nsDialogs.nsh; only GWL_STYLE is missing.
!define AOS_GWL_STYLE -16

Name "${APP_NAME}"
Caption "${APP_NAME} Setup"
OutFile "${OUTPUT_DIR}\${APP_NAME}-Setup-${APP_VERSION}.exe"
InstallDir "$LOCALAPPDATA\Programs\${APP_NAME}"
InstallDirRegKey HKCU "Software\${APP_NAME}" "InstallDir"
RequestExecutionLevel user
BrandingText "${APP_NAME} ${APP_VERSION}"
ShowInstDetails show
ShowUninstDetails show
InstallColors ${COLOR_INK} ${COLOR_BLACK}
InstProgressFlags smooth colored

Icon "${SETUP_ICON}"
UninstallIcon "${SETUP_ICON}"

VIProductVersion "${APP_VERSION}.0"
VIAddVersionKey /LANG=1033 "ProductName" "${APP_NAME}"
VIAddVersionKey /LANG=1033 "ProductVersion" "${APP_VERSION}"
VIAddVersionKey /LANG=1033 "CompanyName" "${APP_PUBLISHER}"
VIAddVersionKey /LANG=1033 "FileDescription" "${APP_NAME} Setup"
VIAddVersionKey /LANG=1033 "FileVersion" "${APP_VERSION}"
VIAddVersionKey /LANG=1033 "LegalCopyright" "Copyright 2026 AnyOSStack contributors"

Var PageDialog
Var BackgroundControl
Var BackgroundHandle
Var LicenseCheckbox
Var LicenseTextControl
Var LicenseFile
Var LicenseLine
Var DirectoryField
Var BrowseButton
Var LaunchCheckbox
Var DesktopShortcutCheckbox
Var StartMenuShortcutCheckbox
Var CreateDesktopShortcut
Var CreateStartMenuShortcut
Var LanguageCombo
Var NextButton
Var LangBar
Var LangOpen
Var LangSel
Var ConfirmBand
Var ConfirmText
Var ConfirmYes
Var ConfirmNo
Var UiFont
Var UiFontBold
Var UiFontMono
Var UiFontTitle
Var UiFontTitleSm
Var UiFontBodySm
Var UiFontEyebrow
Var UiFontNav
Var UiFontNavBold
Var InstallBackgroundControl
Var InstallBackgroundHandle

Page custom LanguageCreate LanguageLeave
Page custom WelcomeCreate WelcomeLeave
Page custom LicenseCreate LicenseLeave
Page custom DestinationCreate DestinationLeave
Page instfiles InstFilesPre InstFilesShow
Page custom FinishCreate FinishLeave

; The stock uninstConfirm page is a plain grey Windows dialog; this is the same
; branded shell the installer uses, with painted buttons.
UninstPage custom un.ConfirmCreate
UninstPage instfiles un.InstFilesPre un.InstFilesShow
UninstPage custom un.DoneCreate

!include "${BUILD}\anyosstack-languages.nsh"

; One variable per picker row (generated alongside the language table).
!insertmacro AOS_LANG_VARS

; ---------------------------------------------------------------------------
; Localized static text = native label over the bitmap chrome.
;   X Y W H  : pixels inside the 1064x610 page (matches generate-installer-ui.js)
;   FONT     : one of the $UiFont* handles created in .onGUIInit
;   FG BG    : SetCtlColors pair; BG must match the flat color underneath
;   ALIGN    : 0 for left, ${SS_CENTER} to center inside W
; ---------------------------------------------------------------------------
!macro AOS_TEXT X Y W H FONT FG BG ALIGN TEXT
  ${NSD_CreateLabel} 0 0 10 10 "${TEXT}"
  Pop $R9
  System::Call 'user32::GetWindowLongW(p $R9, i ${AOS_GWL_STYLE}) i.r8'
  IntOp $8 $8 | ${ALIGN}
  System::Call 'user32::SetWindowLongW(p $R9, i ${AOS_GWL_STYLE}, i $8)'
  System::Call 'user32::SetWindowPos(p $R9, p 0, i ${X}, i ${Y}, i ${W}, i ${H}, i 0x0014)'
  SendMessage $R9 ${WM_SETFONT} ${FONT} 0
  SetCtlColors $R9 ${FG} ${BG}
!macroend

; A native push button paints its own face from the system theme, so
; SetCtlColors cannot reach it - that is why Next/Cancel stayed stock white on an
; otherwise dark wizard, whatever theme was applied. These are SS_NOTIFY labels
; styled as buttons; the click is forwarded to the real NSIS command
; (WM_COMMAND 1/2/3), so page flow, validation and Abort behave exactly as
; before. 0x201 = SS_CENTER|SS_CENTERIMAGE, i.e. text centred both ways.
!macro AOS_BTN X Y W H FG BG TEXT HANDLER
  !insertmacro AOS_TEXT ${X} ${Y} ${W} ${H} $UiFontBold ${FG} ${BG} 0x201 "${TEXT}"
  ${NSD_OnClick} $R9 ${HANDLER}
!macroend

; The branded replacement for the cancel confirmation. A Windows MessageBox is
; drawn by the system and cannot be recoloured, so the question is asked inside
; the wizard instead: a band across the button row with two painted buttons.
; Created hidden on every page and raised above the navigation when shown.
!macro AOS_CONFIRM
  !insertmacro AOS_TEXT 0 600 1064 76 $UiFont ${COLOR_BG} ${COLOR_BG} 0 ""
  StrCpy $ConfirmBand $R9
  ShowWindow $R9 ${SW_HIDE}
  !insertmacro AOS_TEXT 40 616 660 42 $UiFontBold ${COLOR_INK} ${COLOR_BG} 0x200 "$(AOS_CONFIRM_CANCEL)"
  StrCpy $ConfirmText $R9
  ShowWindow $R9 ${SW_HIDE}
  !insertmacro AOS_BTN 720 616 150 42 ${COLOR_BLACK} ${COLOR_ORANGE} "$(AOS_YES)" OnConfirmYes
  StrCpy $ConfirmYes $R9
  ShowWindow $R9 ${SW_HIDE}
  !insertmacro AOS_BTN 878 616 160 42 ${COLOR_INK} ${COLOR_SURFACE} "$(AOS_NO)" OnConfirmNo
  StrCpy $ConfirmNo $R9
  ShowWindow $R9 ${SW_HIDE}
!macroend

; One row of the language picker. Rows are our own labels, so their colours - and
; the selected row's highlight - are ours too; a native list paints its selection
; with the system accent and nothing can override it. 0x200 = SS_CENTERIMAGE.
!macro AOS_LANG_ROW X Y NAME
  !insertmacro AOS_TEXT ${X} ${Y} 222 24 $UiFont ${COLOR_INK} ${COLOR_SURFACE} 0x200 "  ${NAME}"
  ${NSD_OnClick} $R9 OnLangRow
  ShowWindow $R9 ${SW_HIDE}
!macroend

; Classic (unthemed) controls draw a sunken 3D border from the system palette,
; which lands as a white frame on a dark page. Dropping WS_EX_CLIENTEDGE removes
; it; the artwork already draws the frame these fields sit in.
!macro AOS_NO_EDGE HWND
  System::Call 'user32::GetWindowLongW(p ${HWND}, i -20) i.r8'
  IntOp $8 $8 & 0xFFFFFDFF ; ~WS_EX_CLIENTEDGE
  System::Call 'user32::SetWindowLongW(p ${HWND}, i -20, i $8)'
  ; SWP_NOMOVE|SWP_NOSIZE|SWP_NOZORDER|SWP_FRAMECHANGED
  System::Call 'user32::SetWindowPos(p ${HWND}, p 0, i 0, i 0, i 0, i 0, i 0x0027)'
!macroend

; Opt a single control into Windows' dark control theme. SetWindowTheme alone is
; not enough: the window has to be allowed into dark mode first (uxtheme ordinal
; 133) and then told to re-read its theme.
!macro AOS_DARK_CTL HWND
  System::Call 'uxtheme::#133(p ${HWND}, i 1) i.r0'
  System::Call 'uxtheme::SetWindowTheme(p ${HWND}, w "DarkMode_Explorer", p 0)'
  SendMessage ${HWND} ${WM_THEMECHANGED} 0 0
!macroend


; Text fields are themed by the common-file-dialog class, not the explorer one -
; "DarkMode_Explorer" leaves an edit box stark white on an otherwise dark page.
!macro AOS_DARK_EDIT HWND
  System::Call 'uxtheme::#133(p ${HWND}, i 1) i.r0'
  System::Call 'uxtheme::SetWindowTheme(p ${HWND}, w "DarkMode_CFD", p 0)'
  SendMessage ${HWND} ${WM_THEMECHANGED} 0 0
!macroend

; One sidebar step. The active row sits on the highlight pill, so it needs the
; pill's background color instead of the sidebar's.
!macro AOS_NAV INDEX ACTIVE TEXT
  !define /math _AOS_NAV_Y ${INDEX} * 54
  !define /math _AOS_NAV_TOP ${_AOS_NAV_Y} + 135
  !if ${INDEX} == ${ACTIVE}
    !insertmacro AOS_TEXT 66 ${_AOS_NAV_TOP} 152 20 $UiFontNavBold ${COLOR_LIGHT} ${COLOR_SURFACE} 0 "${TEXT}"
  !else
    !insertmacro AOS_TEXT 66 ${_AOS_NAV_TOP} 152 20 $UiFontNav ${COLOR_MUTED} ${COLOR_SIDEBAR} 0 "${TEXT}"
  !endif
  !undef _AOS_NAV_Y
  !undef _AOS_NAV_TOP
!macroend

; Same thing without nsDialogs. The instfiles page is a stock NSIS dialog, and
; nsDialogs::CreateControl on a dialog nsDialogs did not create takes the
; installer down with it - so that page builds its labels with plain Win32.
; 0x54000000 = WS_CHILD|WS_VISIBLE|WS_CLIPSIBLINGS - without CLIPSIBLINGS the
; background bitmap repaints straight over the labels. STYLE is passed whole (+1 adds SS_CENTER):
; System::Call does not evaluate an expression like 0x50000000|1 in an argument.
!macro AOS_TEXT_RAW X Y W H FONT FG BG STYLE TEXT
  System::Call 'user32::CreateWindowExW(i 0, w "STATIC", w "", i ${STYLE}, i ${X}, i ${Y}, i ${W}, i ${H}, p $PageDialog, p 0, p 0, p 0) p.r9'
  SendMessage $9 ${WM_SETTEXT} 0 "STR:${TEXT}"
  SendMessage $9 ${WM_SETFONT} ${FONT} 0
  SetCtlColors $9 ${FG} ${BG}
!macroend

!macro AOS_NAV_RAW INDEX ACTIVE TEXT
  !define /math _AOS_RAW_Y ${INDEX} * 54
  !define /math _AOS_RAW_TOP ${_AOS_RAW_Y} + 135
  !if ${INDEX} == ${ACTIVE}
    !insertmacro AOS_TEXT_RAW 66 ${_AOS_RAW_TOP} 152 20 $UiFontNavBold ${COLOR_LIGHT} ${COLOR_SURFACE} 0x54000000 "${TEXT}"
  !else
    !insertmacro AOS_TEXT_RAW 66 ${_AOS_RAW_TOP} 152 20 $UiFontNav ${COLOR_MUTED} ${COLOR_SIDEBAR} 0x54000000 "${TEXT}"
  !endif
  !undef _AOS_RAW_Y
  !undef _AOS_RAW_TOP
!macroend

!macro AOS_SIDEBAR_RAW ACTIVE
  !insertmacro AOS_TEXT_RAW 78 64 150 16 $UiFontEyebrow ${COLOR_INK} ${COLOR_SIDEBAR} 0x54000000 "$(AOS_VERSION) ${APP_VERSION}"
  !insertmacro AOS_NAV_RAW 0 ${ACTIVE} "$(AOS_NAV_WELCOME)"
  !insertmacro AOS_NAV_RAW 1 ${ACTIVE} "$(AOS_NAV_LICENSE)"
  !insertmacro AOS_NAV_RAW 2 ${ACTIVE} "$(AOS_NAV_DESTINATION)"
  !insertmacro AOS_NAV_RAW 3 ${ACTIVE} "$(AOS_NAV_INSTALLATION)"
  !insertmacro AOS_NAV_RAW 4 ${ACTIVE} "$(AOS_NAV_FINISH)"
!macroend

!macro AOS_SIDEBAR ACTIVE
  !insertmacro AOS_TEXT 78 64 150 16 $UiFontEyebrow ${COLOR_INK} ${COLOR_SIDEBAR} 0 "$(AOS_VERSION) ${APP_VERSION}"
  !insertmacro AOS_NAV 0 ${ACTIVE} "$(AOS_NAV_WELCOME)"
  !insertmacro AOS_NAV 1 ${ACTIVE} "$(AOS_NAV_LICENSE)"
  !insertmacro AOS_NAV 2 ${ACTIVE} "$(AOS_NAV_DESTINATION)"
  !insertmacro AOS_NAV 3 ${ACTIVE} "$(AOS_NAV_INSTALLATION)"
  !insertmacro AOS_NAV 4 ${ACTIVE} "$(AOS_NAV_FINISH)"
!macroend

Function .onInit
  ; The twelve languages are offered by the branded LanguageCreate page instead
  ; of LangDLL's stock grey dialog. Here we only preselect: a remembered choice
  ; first, otherwise whatever NSIS matched against the Windows UI language.
  ReadRegStr $0 HKCU "Software\${APP_NAME}" "InstallerLanguage"
  ${If} $0 != ""
    StrCpy $LANGUAGE "$0"
  ${EndIf}
  ; Both shortcuts are opt-out, matching what the wizard offers on the
  ; destination page.
  StrCpy $CreateDesktopShortcut 1
  StrCpy $CreateStartMenuShortcut 1
  InitPluginsDir
  ; Ask for dark mode now: the GUI does not exist yet, so every control NSIS is
  ; about to create starts out themed. It has to come AFTER InitPluginsDir -
  ; System::Call before that silently does nothing, because System.dll is
  ; extracted into $PLUGINSDIR. uxtheme #135 = SetPreferredAppMode, 2 = ForceDark.
  System::Call 'uxtheme::#135(i 2) i.r0'
  SetOutPath "$PLUGINSDIR"
  File "/oname=language.bmp"    "${UI_ASSETS}\language.bmp"
  File "/oname=welcome.bmp"     "${UI_ASSETS}\welcome.bmp"
  File "/oname=license.bmp"     "${UI_ASSETS}\license.bmp"
  File "/oname=destination.bmp" "${UI_ASSETS}\destination.bmp"
  File "/oname=installing.bmp"  "${UI_ASSETS}\installing.bmp"
  File "/oname=finish.bmp"      "${UI_ASSETS}\finish.bmp"
  File "/oname=LICENSE.txt"     "${PROJ}\LICENSE"
FunctionEnd

Function .onGUIInit
  ; Keep a dedicated command strip below the 1064x610 custom page.
  System::Call 'user32::GetSystemMetrics(i 0) i.r0'
  System::Call 'user32::GetSystemMetrics(i 1) i.r1'
  IntOp $0 $0 - 1080
  IntOp $0 $0 / 2
  IntOp $1 $1 - 720
  IntOp $1 $1 / 2
  System::Call 'user32::SetWindowPos(p $HWNDPARENT, p 0, i $0, i $1, i 1080, i 720, i 0x0040)'

  ; Ask supported Windows versions for a dark title bar.
  System::Call 'uxtheme::#135(i 2) i.r0'
  System::Call 'uxtheme::#133(p $HWNDPARENT, i 1) i.r0'
  System::Call 'dwmapi::DwmSetWindowAttribute(p $HWNDPARENT, i 20, *i 1, i 4)'

  ; Point sizes mirror the pixel sizes the artwork was designed against
  ; (px * 0.75 at 96 DPI).
  CreateFont $UiFont       "Segoe UI" 10 400
  CreateFont $UiFontBold   "Segoe UI Semibold" 10 600
  CreateFont $UiFontMono   "Cascadia Mono" 9 400
  CreateFont $UiFontTitle  "Segoe UI Semibold" 31 700
  CreateFont $UiFontTitleSm "Segoe UI Semibold" 22 600
  CreateFont $UiFontBodySm "Segoe UI" 10 400
  CreateFont $UiFontEyebrow "Cascadia Mono" 8 400
  CreateFont $UiFontNav    "Segoe UI" 11 400
  CreateFont $UiFontNavBold "Segoe UI Semibold" 11 600
  SetCtlColors $HWNDPARENT ${COLOR_INK} ${COLOR_BG}
  Call PositionNavigation
FunctionEnd

Function PositionNavigation
  ; Use NSIS' real navigation buttons. They retain native focus, keyboard,
  ; validation and page-transition behavior on every Windows version - only the
  ; paint job is ours (see AOS_BRAND_BTN).
  GetDlgItem $0 $HWNDPARENT 3
  System::Call 'user32::SetWindowPos(p $0, p 0, i 734, i 624, i 96, i 40, i 0x0014)'
  SendMessage $0 ${WM_SETFONT} $UiFontBold 0
  !insertmacro AOS_DARK_CTL $0
  ShowWindow $0 ${SW_SHOW}

  GetDlgItem $0 $HWNDPARENT 1
  System::Call 'user32::SetWindowPos(p $0, p 0, i 838, i 624, i 96, i 40, i 0x0014)'
  SendMessage $0 ${WM_SETFONT} $UiFontBold 0
  !insertmacro AOS_DARK_CTL $0
  ShowWindow $0 ${SW_SHOW}

  GetDlgItem $0 $HWNDPARENT 2
  System::Call 'user32::SetWindowPos(p $0, p 0, i 942, i 624, i 96, i 40, i 0x0014)'
  SendMessage $0 ${WM_SETFONT} $UiFontBold 0
  !insertmacro AOS_DARK_CTL $0
  ShowWindow $0 ${SW_SHOW}

  ; Hide the stock horizontal separator; the bitmap shell owns the layout.
  GetDlgItem $0 $HWNDPARENT 1035
  ShowWindow $0 ${SW_HIDE}
FunctionEnd

Function PrepareCustomPage
  ; Taller than the 610px artwork: the extra strip at the bottom is where the
  ; painted navigation buttons live, so they belong to the page dialog and can be
  ; coloured and clicked like any other control on it.
  System::Call 'user32::SetWindowPos(p $PageDialog, p 0, i 0, i 0, i 1064, i 676, i 0x0014)'
  SetCtlColors $PageDialog ${COLOR_INK} ${COLOR_BG}
  Call HideNativeNav
FunctionEnd

Function HideNativeNav
  ; The stock buttons stay alive - they still own the page flow - but they are
  ; not shown; the painted labels forward every click to them.
  GetDlgItem $0 $HWNDPARENT 1
  ShowWindow $0 ${SW_HIDE}
  GetDlgItem $0 $HWNDPARENT 2
  ShowWindow $0 ${SW_HIDE}
  GetDlgItem $0 $HWNDPARENT 3
  ShowWindow $0 ${SW_HIDE}
  GetDlgItem $0 $HWNDPARENT 1035
  ShowWindow $0 ${SW_HIDE}
FunctionEnd

Function OnNavNext
  SendMessage $HWNDPARENT ${WM_COMMAND} 1 0
FunctionEnd

Function OnNavBack
  SendMessage $HWNDPARENT ${WM_COMMAND} 3 0
FunctionEnd

Function OnNavCancel
  SendMessage $HWNDPARENT ${WM_COMMAND} 2 0
FunctionEnd

; NSIS routes every cancel - our painted button, the title bar X, Esc - through
; here, so one confirmation covers all of them.
Function .onUserAbort
  MessageBox MB_YESNO|MB_ICONQUESTION "$(AOS_CONFIRM_CANCEL)" IDYES +2
    Abort ; "Abort" in .onUserAbort means "do not quit"
FunctionEnd


Function AddBackground
  ; LoadImage + STM_SETIMAGE instead of ${NSD_SetStretchedBitmap}: the macro only
  ; exists in newer nsDialogs, and this script has to compile with the makensis
  ; that ships in electron-builder's cache.
  Exch $0
  ${NSD_CreateBitmap} 0 0 100% 100% ""
  Pop $BackgroundControl
  System::Call 'user32::LoadImageW(p 0, w "$0", i 0, i 1064, i 610, i 0x0010) p.r1'
  StrCpy $BackgroundHandle $1
  SendMessage $BackgroundControl 0x0172 0 $BackgroundHandle ; STM_SETIMAGE, IMAGE_BITMAP
  Pop $0
FunctionEnd

Function RepaintPage
  ; Sinking the artwork to the bottom of the z-order invalidates the region it
  ; covers, and Windows repaints only that region - the labels and painted
  ; buttons layered on top are never invalidated, so they come out blank.
  ; RDW_INVALIDATE|RDW_ALLCHILDREN|RDW_UPDATENOW redraws the page and every
  ; control on it.
  System::Call 'user32::RedrawWindow(p $PageDialog, p 0, p 0, i 0x0181)'
FunctionEnd

Function LangRowsVisibility
  ${If} $LangOpen == 1
    !insertmacro AOS_LANG_SHOW ${SW_SHOW}
  ${Else}
    !insertmacro AOS_LANG_SHOW ${SW_HIDE}
  ${EndIf}
  Call RepaintPage
FunctionEnd

Function LangRefresh
  StrCpy $2 ""
  !insertmacro AOS_LANG_NAME $LangSel $2
  SendMessage $LangBar ${WM_SETTEXT} 0 "STR:  $2"
  !insertmacro AOS_LANG_PAINT
FunctionEnd

Function OnLangBar
  Pop $0
  ${If} $LangOpen == 1
    StrCpy $LangOpen 0
  ${Else}
    StrCpy $LangOpen 1
  ${EndIf}
  Call LangRowsVisibility
FunctionEnd

Function OnLangRow
  Pop $0
  !insertmacro AOS_LANG_FROM_HWND $0
  StrCpy $LangOpen 0
  Call LangRefresh
  Call LangRowsVisibility
FunctionEnd

Function SinkBackground
  ; nsDialogs adds each new control BELOW its siblings, so the artwork - created
  ; first - ends up on top and hides every label. Push it to HWND_BOTTOM once the
  ; page is fully built, right before nsDialogs::Show.
  System::Call 'user32::SetWindowPos(p $BackgroundControl, p 1, i 0, i 0, i 1064, i 610, i 0x0010)'
FunctionEnd

Function ReleaseBackground
  ${If} $BackgroundHandle != 0
    System::Call 'gdi32::DeleteObject(p $BackgroundHandle)'
    StrCpy $BackgroundHandle 0
  ${EndIf}
FunctionEnd

Function LanguageCreate
  nsDialogs::Create 1018
  Pop $PageDialog
  ${If} $PageDialog == error
    Abort
  ${EndIf}
  Call PrepareCustomPage
  Push "$PLUGINSDIR\language.bmp"
  Call AddBackground

  !insertmacro AOS_SIDEBAR 99 ; no step is active yet
  !insertmacro AOS_TEXT 400 208 548 40 $UiFontTitleSm ${COLOR_INK} ${COLOR_CARD} ${SS_CENTER} "$(AOS_LANG_TITLE)"
  !insertmacro AOS_TEXT 420 256 508 24 $UiFont ${COLOR_LIGHT} ${COLOR_CARD} ${SS_CENTER} "$(AOS_LANG_SUB)"

  ; A closed bar that opens a panel of twelve rows - all of them our own labels.
  ; Neither a combo nor a list box can be fully styled: a combo's drop-down is a
  ; separate top-level window this dialog never gets WM_CTLCOLOR* for, and both
  ; paint their selection with the system accent (the blue bar).
  StrCpy $LangOpen 0
  !insertmacro AOS_LANG_INDEX
  !insertmacro AOS_TEXT 448 337 452 38 $UiFont ${COLOR_INK} ${COLOR_BLACK} 0x200 ""
  StrCpy $LangBar $R9
  ${NSD_OnClick} $R9 OnLangBar
  ; Caret at the right edge so the bar reads as a drop-down; clicking it opens too.
  !insertmacro AOS_TEXT 862 337 34 38 $UiFont ${COLOR_LIGHT} ${COLOR_BLACK} 0x201 "▼"
  ${NSD_OnClick} $R9 OnLangBar
  !insertmacro AOS_LANG_ROWS
  Call LangRefresh

  !insertmacro AOS_BTN 838 616 96 42 ${COLOR_BLACK} ${COLOR_ORANGE} "$(AOS_BTN_NEXT)" OnNavNext
  !insertmacro AOS_BTN 942 616 96 42 ${COLOR_MUTED} ${COLOR_SURFACE} "$(AOS_BTN_CANCEL)" OnNavCancel

  Call SinkBackground
  Call RepaintPage
  nsDialogs::Show
FunctionEnd

Function LanguageLeave
  ${If} $LangSel >= 0
    !insertmacro AOS_LANG_APPLY $LangSel
    WriteRegStr HKCU "Software\${APP_NAME}" "InstallerLanguage" "$LANGUAGE"
  ${EndIf}
  Call ReleaseBackground
FunctionEnd

Function WelcomeCreate
  nsDialogs::Create 1018
  Pop $PageDialog
  ${If} $PageDialog == error
    Abort
  ${EndIf}
  Call PrepareCustomPage
  Push "$PLUGINSDIR\welcome.bmp"
  Call AddBackground

  !insertmacro AOS_SIDEBAR 0
  !insertmacro AOS_TEXT 400 210 548 40 $UiFontTitleSm ${COLOR_INK} ${COLOR_CARD} ${SS_CENTER} "$(AOS_W_TITLE)"
  !insertmacro AOS_TEXT 400 254 548 56 $UiFontTitle ${COLOR_INK} ${COLOR_CARD} ${SS_CENTER} "$(AOS_W_TAGLINE)"
  !insertmacro AOS_TEXT 420 345 508 26 $UiFont ${COLOR_LIGHT} ${COLOR_CARD} ${SS_CENTER} "$(AOS_W_BODY)"
  !insertmacro AOS_TEXT 420 399 508 44 $UiFontBodySm ${COLOR_MUTED} ${COLOR_CARD} ${SS_CENTER} "$(AOS_W_NOTE)"
  !insertmacro AOS_TEXT 420 486 508 22 $UiFontMono ${COLOR_MUTED} ${COLOR_CARD} ${SS_CENTER} "$(AOS_W_HINT)"

  !insertmacro AOS_BTN 838 616 96 42 ${COLOR_BLACK} ${COLOR_ORANGE} "$(AOS_BTN_NEXT)" OnNavNext
  !insertmacro AOS_BTN 942 616 96 42 ${COLOR_MUTED} ${COLOR_SURFACE} "$(AOS_BTN_CANCEL)" OnNavCancel

  Call SinkBackground
  Call RepaintPage
  nsDialogs::Show
FunctionEnd

Function WelcomeLeave
  Call ReleaseBackground
FunctionEnd

Function LicenseCreate
  nsDialogs::Create 1018
  Pop $PageDialog
  ${If} $PageDialog == error
    Abort
  ${EndIf}
  Call PrepareCustomPage
  Push "$PLUGINSDIR\license.bmp"
  Call AddBackground

  !insertmacro AOS_SIDEBAR 1
  !insertmacro AOS_TEXT 284 32 700 40 $UiFontTitleSm ${COLOR_INK} ${COLOR_BG} 0 "$(AOS_L_TITLE)"
  !insertmacro AOS_TEXT 284 78 700 24 $UiFont ${COLOR_LIGHT} ${COLOR_BG} 0 "$(AOS_L_SUB)"
  !insertmacro AOS_TEXT 306 174 500 18 $UiFontEyebrow ${COLOR_CYAN} ${COLOR_BLACK} 0 "$(AOS_L_SECTION)"

  ; Absolute pixels keep the license box inside the frame drawn in the bitmap.
  ${NSD_CreateRichEdit} 0 0 10 10 ""
  Pop $LicenseTextControl
  System::Call 'user32::SetWindowPos(p $LicenseTextControl, p 0, i 306, i 200, i 692, i 268, i 0x0014)'
  SendMessage $LicenseTextControl ${WM_SETFONT} $UiFontMono 0
  ; Theme first: WM_THEMECHANGED makes a rich edit re-read its system colors and
  ; would undo the colors set below if it arrived afterwards.
  !insertmacro AOS_DARK_EDIT $LicenseTextControl

  ; Append the complete LICENSE file line by line. This avoids NSIS' per-string
  ; size limit while keeping the full text scrollable and selectable.
  FileOpen $LicenseFile "$PLUGINSDIR\LICENSE.txt" r
  ${Do}
    ClearErrors
    FileRead $LicenseFile $LicenseLine
    ${IfThen} ${Errors} ${|} ${ExitDo} ${|}
    SendMessage $LicenseTextControl ${EM_SETSEL} -1 -1
    SendMessage $LicenseTextControl ${EM_REPLACESEL} 0 "STR:$LicenseLine"
  ${Loop}
  FileClose $LicenseFile
  SendMessage $LicenseTextControl ${EM_SETSEL} 0 0
  SendMessage $LicenseTextControl ${EM_SCROLLCARET} 0 0
  SendMessage $LicenseTextControl ${EM_SETREADONLY} 1 0

  ; A rich edit owns its painting, so SetCtlColors cannot reach it. Recolor it
  ; after the text is in place: EM_SETCHARFORMAT/SCF_ALL only repaints content
  ; that already exists. COLORREF is 0x00BBGGRR.
  System::Call 'user32::SendMessageW(p $LicenseTextControl, i 0x443, p 0, p 0x000E0E0E)' ; EM_SETBKGNDCOLOR
  System::Call '*(i 92, i 0x40000000, i 0, i 0, i 0, i 0x00E1E2E5, &i1 0, &i1 0, &t32 "", i 0) p.r1'
  System::Call 'user32::SendMessageW(p $LicenseTextControl, i 0x444, p 4, p $1)' ; EM_SETCHARFORMAT, SCF_ALL
  System::Free $1

  ${NSD_CreateCheckbox} 0 0 10 10 "$(AOS_LICENSE_ACK)"
  Pop $LicenseCheckbox
  System::Call 'user32::SetWindowPos(p $LicenseCheckbox, p 0, i 284, i 502, i 660, i 24, i 0x0014)'
  SendMessage $LicenseCheckbox ${WM_SETFONT} $UiFontBold 0
  SetCtlColors $LicenseCheckbox ${COLOR_INK} ${COLOR_BG}
  ${NSD_OnClick} $LicenseCheckbox LicenseToggle

  !insertmacro AOS_TEXT 284 532 700 20 $UiFontMono ${COLOR_MUTED} ${COLOR_BG} 0 "$(AOS_L_FOOT)"

  !insertmacro AOS_BTN 734 616 96 42 ${COLOR_INK} ${COLOR_SURFACE} "$(AOS_BTN_BACK)" OnNavBack
  ; Muted until the licence is acknowledged; LicenseToggle repaints it.
  !insertmacro AOS_BTN 838 616 96 42 ${COLOR_MUTED} ${COLOR_SURFACE} "$(AOS_BTN_NEXT)" OnNavNext
  StrCpy $NextButton $R9
  !insertmacro AOS_BTN 942 616 96 42 ${COLOR_MUTED} ${COLOR_SURFACE} "$(AOS_BTN_CANCEL)" OnNavCancel

  Call SinkBackground
  Call RepaintPage
  nsDialogs::Show
FunctionEnd

Function LicenseToggle
  ${NSD_GetState} $LicenseCheckbox $0
  ${If} $0 == ${BST_CHECKED}
    SetCtlColors $NextButton ${COLOR_BLACK} ${COLOR_ORANGE}
  ${Else}
    SetCtlColors $NextButton ${COLOR_MUTED} ${COLOR_SURFACE}
  ${EndIf}
  System::Call 'user32::InvalidateRect(p $NextButton, p 0, i 1)'
FunctionEnd

Function LicenseLeave
  ${NSD_GetState} $LicenseCheckbox $0
  ${If} $0 != ${BST_CHECKED}
    Abort
  ${EndIf}
  Call ReleaseBackground
FunctionEnd

Function DestinationCreate
  nsDialogs::Create 1018
  Pop $PageDialog
  ${If} $PageDialog == error
    Abort
  ${EndIf}
  Call PrepareCustomPage
  Push "$PLUGINSDIR\destination.bmp"
  Call AddBackground

  !insertmacro AOS_SIDEBAR 2
  !insertmacro AOS_TEXT 284 32 700 40 $UiFontTitleSm ${COLOR_INK} ${COLOR_BG} 0 "$(AOS_D_TITLE)"
  !insertmacro AOS_TEXT 284 78 700 24 $UiFont ${COLOR_LIGHT} ${COLOR_BG} 0 "$(AOS_D_SUB)"
  !insertmacro AOS_TEXT 390 250 550 40 $UiFontTitleSm ${COLOR_INK} ${COLOR_CARD} ${SS_CENTER} "$(AOS_D_CARD_TITLE)"
  !insertmacro AOS_TEXT 400 292 530 46 $UiFontBodySm ${COLOR_MUTED} ${COLOR_CARD} ${SS_CENTER} "$(AOS_D_CARD_BODY)"
  !insertmacro AOS_TEXT 402 356 300 18 $UiFontEyebrow ${COLOR_CYAN} ${COLOR_CARD} 0 "$(AOS_D_FIELD)"

  ${NSD_CreateDirRequest} 0 0 10 10 "$INSTDIR"
  Pop $DirectoryField
  System::Call 'user32::SetWindowPos(p $DirectoryField, p 0, i 408, i 392, i 414, i 30, i 0x0014)'
  SendMessage $DirectoryField ${WM_SETFONT} $UiFont 0
  ; Unthemed + no sunken 3D edge: the artwork already draws this field's frame,
  ; and the classic edge rendered as a white outline on the dark card.
  System::Call 'uxtheme::SetWindowTheme(p $DirectoryField, w " ", w " ")'
  !insertmacro AOS_NO_EDGE $DirectoryField
  SetCtlColors $DirectoryField ${COLOR_INK} ${COLOR_BLACK}

  ; Painted, like the navigation buttons: a real push button draws its own face
  ; from the system theme, so Browse stayed white on the dark card.
  !insertmacro AOS_BTN 832 389 92 36 ${COLOR_INK} ${COLOR_SURFACE} "$(AOS_BTN_BROWSE)" DestinationBrowse
  StrCpy $BrowseButton $R9

  ${NSD_CreateCheckbox} 0 0 10 10 "$(AOS_D_DESKTOP)"
  Pop $DesktopShortcutCheckbox
  System::Call 'user32::SetWindowPos(p $DesktopShortcutCheckbox, p 0, i 402, i 444, i 520, i 22, i 0x0014)'
  SendMessage $DesktopShortcutCheckbox ${WM_SETFONT} $UiFont 0
  SetCtlColors $DesktopShortcutCheckbox ${COLOR_INK} ${COLOR_CARD}
  ${If} $CreateDesktopShortcut != 0
    ${NSD_Check} $DesktopShortcutCheckbox
  ${EndIf}

  ${NSD_CreateCheckbox} 0 0 10 10 "$(AOS_D_STARTMENU)"
  Pop $StartMenuShortcutCheckbox
  System::Call 'user32::SetWindowPos(p $StartMenuShortcutCheckbox, p 0, i 402, i 470, i 520, i 22, i 0x0014)'
  SendMessage $StartMenuShortcutCheckbox ${WM_SETFONT} $UiFont 0
  SetCtlColors $StartMenuShortcutCheckbox ${COLOR_INK} ${COLOR_CARD}
  ${If} $CreateStartMenuShortcut != 0
    ${NSD_Check} $StartMenuShortcutCheckbox
  ${EndIf}

  !insertmacro AOS_TEXT 402 530 560 20 $UiFontMono ${COLOR_MUTED} ${COLOR_BG} 0 "$(AOS_D_FOOT)"

  !insertmacro AOS_BTN 734 616 96 42 ${COLOR_INK} ${COLOR_SURFACE} "$(AOS_BTN_BACK)" OnNavBack
  !insertmacro AOS_BTN 838 616 96 42 ${COLOR_BLACK} ${COLOR_ORANGE} "$(AOS_BTN_INSTALL)" OnNavNext
  !insertmacro AOS_BTN 942 616 96 42 ${COLOR_MUTED} ${COLOR_SURFACE} "$(AOS_BTN_CANCEL)" OnNavCancel

  Call SinkBackground
  Call RepaintPage
  nsDialogs::Show
FunctionEnd

Function DestinationBrowse
  nsDialogs::SelectFolderDialog "$(AOS_CHOOSE_DIR)" "$INSTDIR"
  Pop $0
  ${If} $0 != error
    ${NSD_SetText} $DirectoryField "$0"
  ${EndIf}
FunctionEnd

Function DestinationLeave
  ${NSD_GetState} $DesktopShortcutCheckbox $CreateDesktopShortcut
  ${NSD_GetState} $StartMenuShortcutCheckbox $CreateStartMenuShortcut
  ${NSD_GetText} $DirectoryField $INSTDIR
  ${If} $INSTDIR == ""
    MessageBox MB_ICONEXCLAMATION|MB_OK "$(AOS_CHOOSE_DIR)"
    Abort
  ${EndIf}
  Call ReleaseBackground
FunctionEnd

Function InstFilesPre
  GetDlgItem $0 $HWNDPARENT 3
  ShowWindow $0 ${SW_HIDE}
  GetDlgItem $0 $HWNDPARENT 1
  EnableWindow $0 0
  GetDlgItem $0 $HWNDPARENT 2
  EnableWindow $0 0
FunctionEnd

Function InstFilesShow
  ; Look the inner dialog up by class, not by control id: the nsDialogs pages
  ; that ran before this one leave their own id-1018 child behind, so GetDlgItem
  ; hands back that stale window and the whole page stays stock-sized.
  FindWindow $PageDialog "#32770" "" $HWNDPARENT
  System::Call 'user32::SetWindowPos(p $PageDialog, p 0, i 0, i 0, i 1064, i 610, i 0x0014)'
  SetCtlColors $PageDialog ${COLOR_INK} ${COLOR_BG}
  Call HideNativeNav

  ; Place the generated installation shell behind the stock live controls.
  System::Call 'user32::CreateWindowExW(i 0, w "STATIC", w "", i 0x5400000E, i 0, i 0, i 1064, i 610, p $PageDialog, p 0, p 0, p 0) p.r0'
  StrCpy $InstallBackgroundControl $0
  System::Call 'user32::LoadImageW(p 0, w "$PLUGINSDIR\installing.bmp", i 0, i 1064, i 610, i 0x0010) p.r1'
  StrCpy $InstallBackgroundHandle $1
  SendMessage $InstallBackgroundControl 0x0172 0 $InstallBackgroundHandle

  ; Localized copy for this page, built with plain Win32 (see AOS_TEXT_RAW).
  !insertmacro AOS_SIDEBAR_RAW 3
  !insertmacro AOS_TEXT_RAW 382 100 600 40 $UiFontTitleSm ${COLOR_INK} ${COLOR_CARD} 0x54000000 "$(AOS_I_TITLE)"
  !insertmacro AOS_TEXT_RAW 382 141 600 20 $UiFontMono ${COLOR_LIGHT} ${COLOR_CARD} 0x54000000 "$(AOS_I_SUB)"
  !insertmacro AOS_TEXT_RAW 312 215 300 18 $UiFontEyebrow ${COLOR_CYAN} ${COLOR_CARD} 0x54000000 "$(AOS_I_PROGRESS)"
  !insertmacro AOS_TEXT_RAW 312 314 300 18 $UiFontEyebrow ${COLOR_LIGHT} ${COLOR_CARD} 0x54000000 "$(AOS_I_LOG)"

  ; Artwork last: everything added above has to sit in front of it.
  System::Call 'user32::SetWindowPos(p $InstallBackgroundControl, p 1, i 0, i 0, i 1064, i 610, i 0x0010)'

  ; Live status, progress and installation log align with the visual shell.
  GetDlgItem $0 $PageDialog 1006
  System::Call 'user32::SetWindowPos(p $0, p 0, i 312, i 282, i 680, i 22, i 0x0014)'
  SendMessage $0 ${WM_SETFONT} $UiFontMono 0
  SetCtlColors $0 ${COLOR_MUTED} ${COLOR_CARD}

  GetDlgItem $0 $PageDialog 1004
  System::Call 'user32::SetWindowPos(p $0, p 0, i 312, i 245, i 680, i 32, i 0x0014)'
  SendMessage $0 ${PBM_SETBARCOLOR} 0 0x002257FF
  SendMessage $0 ${PBM_SETBKCOLOR} 0 0x000E0E0E

  GetDlgItem $0 $PageDialog 1016
  System::Call 'user32::SetWindowPos(p $0, p 0, i 312, i 339, i 680, i 167, i 0x0014)'
  SendMessage $0 ${WM_SETFONT} $UiFontMono 0
  SetCtlColors $0 ${COLOR_INK} ${COLOR_BLACK}

  GetDlgItem $0 $PageDialog 1027
  ShowWindow $0 ${SW_HIDE}
  ; Stock 32x32 installer icon in the dialog's top-left corner - the artwork
  ; already carries the brand badge, so this one just sits on top of it.
  GetDlgItem $0 $PageDialog 1002
  ShowWindow $0 ${SW_HIDE}
FunctionEnd

Function FinishCreate
  nsDialogs::Create 1018
  Pop $PageDialog
  ${If} $PageDialog == error
    Abort
  ${EndIf}
  Call PrepareCustomPage
  Push "$PLUGINSDIR\finish.bmp"
  Call AddBackground

  !insertmacro AOS_SIDEBAR 4
  !insertmacro AOS_TEXT 400 241 548 56 $UiFontTitle ${COLOR_INK} ${COLOR_CARD} ${SS_CENTER} "$(AOS_F_TITLE)"
  !insertmacro AOS_TEXT 420 306 508 50 $UiFont ${COLOR_LIGHT} ${COLOR_CARD} ${SS_CENTER} "$(AOS_F_BODY)"
  !insertmacro AOS_TEXT 485 392 380 18 $UiFontEyebrow ${COLOR_ORANGE} ${COLOR_SIDEBAR} 0 "$(AOS_F_ACTION)"

  ${NSD_CreateCheckbox} 0 0 10 10 "$(AOS_LAUNCH)"
  Pop $LaunchCheckbox
  System::Call 'user32::SetWindowPos(p $LaunchCheckbox, p 0, i 485, i 416, i 390, i 24, i 0x0014)'
  SendMessage $LaunchCheckbox ${WM_SETFONT} $UiFontBold 0
  SetCtlColors $LaunchCheckbox ${COLOR_INK} ${COLOR_SIDEBAR}
  ${NSD_Check} $LaunchCheckbox

  !insertmacro AOS_BTN 942 616 96 42 ${COLOR_BLACK} ${COLOR_ORANGE} "$(AOS_BTN_FINISH)" OnNavNext

  Call SinkBackground
  Call RepaintPage
  nsDialogs::Show
FunctionEnd

Function FinishLeave
  ${NSD_GetState} $LaunchCheckbox $0
  Call ReleaseBackground
  ${If} $0 == ${BST_CHECKED}
    Exec '"$INSTDIR\${APP_EXE}"'
  ${EndIf}
FunctionEnd

Section "Install"
  SetDetailsPrint textonly
  DetailPrint "$(AOS_STEP_PREPARE)"
  SetDetailsPrint listonly

  SetOutPath "$INSTDIR"
  File /r "${SRC}\*.*"
  File "/oname=LICENSE.txt" "${PROJ}\LICENSE"
  ; Shortcuts point at this file rather than at the exe's icon index. Windows
  ; caches shell icons per source path, so a shortcut reusing
  ; "AnyOSStack.exe,0" keeps showing whatever was cached for that path first -
  ; which was Electron's default icon from an earlier build.
  File "/oname=AnyOSStack.ico" "${SETUP_ICON}"

  SetDetailsPrint both
  DetailPrint "$(AOS_STEP_SHORTCUTS)"
  ${If} $CreateStartMenuShortcut != 0
    CreateShortCut "$SMPROGRAMS\${APP_NAME}.lnk" "$INSTDIR\${APP_EXE}" "" "$INSTDIR\AnyOSStack.ico" 0
  ${EndIf}
  ${If} $CreateDesktopShortcut != 0
    CreateShortCut "$DESKTOP\${APP_NAME}.lnk" "$INSTDIR\${APP_EXE}" "" "$INSTDIR\AnyOSStack.ico" 0
  ${EndIf}

  DetailPrint "$(AOS_STEP_REGISTER)"
  WriteUninstaller "$INSTDIR\Uninstall.exe"
  WriteRegStr   HKCU "Software\${APP_NAME}" "InstallDir" "$INSTDIR"
  WriteRegStr   HKCU "${UNINST_KEY}" "DisplayName" "${APP_NAME}"
  WriteRegStr   HKCU "${UNINST_KEY}" "DisplayVersion" "${APP_VERSION}"
  WriteRegStr   HKCU "${UNINST_KEY}" "Publisher" "${APP_PUBLISHER}"
  WriteRegStr   HKCU "${UNINST_KEY}" "DisplayIcon" "$INSTDIR\${APP_EXE}"
  WriteRegStr   HKCU "${UNINST_KEY}" "URLInfoAbout" "${APP_URL}"
  WriteRegStr   HKCU "${UNINST_KEY}" "UninstallString" '"$INSTDIR\Uninstall.exe"'
  WriteRegStr   HKCU "${UNINST_KEY}" "QuietUninstallString" '"$INSTDIR\Uninstall.exe" /S'
  WriteRegStr   HKCU "${UNINST_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegDWORD HKCU "${UNINST_KEY}" "NoModify" 1
  WriteRegDWORD HKCU "${UNINST_KEY}" "NoRepair" 1

  ${GetSize} "$INSTDIR" "/S=0K" $0 $1 $2
  IntFmt $0 "0x%08X" $0
  WriteRegDWORD HKCU "${UNINST_KEY}" "EstimatedSize" "$0"
  DetailPrint "$(AOS_STEP_DONE)"

  ; The instfiles page is a stock dialog and cannot carry the painted buttons, so
  ; it has none - go straight to the finish page once the copy is done. Without
  ; this the wizard dead-ends here and the finish page is unreachable.
  GetDlgItem $0 $HWNDPARENT 1
  EnableWindow $0 1
  SendMessage $HWNDPARENT ${WM_COMMAND} 1 0
SectionEnd

Section "Uninstall"
  Delete "$SMPROGRAMS\${APP_NAME}.lnk"
  Delete "$DESKTOP\${APP_NAME}.lnk"
  DeleteRegKey HKCU "${UNINST_KEY}"
  DeleteRegKey HKCU "Software\${APP_NAME}"
  RMDir /r "$INSTDIR"
  ; The progress page carries no buttons of its own, so move straight on to the
  ; branded done page - otherwise the uninstaller dead-ends with no Finish.
  GetDlgItem $0 $HWNDPARENT 1
  EnableWindow $0 1
  SendMessage $HWNDPARENT ${WM_COMMAND} 1 0
SectionEnd

Function un.onGUIInit
  System::Call 'user32::GetSystemMetrics(i 0) i.r0'
  System::Call 'user32::GetSystemMetrics(i 1) i.r1'
  IntOp $0 $0 - 1080
  IntOp $0 $0 / 2
  IntOp $1 $1 - 720
  IntOp $1 $1 / 2
  System::Call 'user32::SetWindowPos(p $HWNDPARENT, p 0, i $0, i $1, i 1080, i 720, i 0x0040)'
  System::Call 'uxtheme::#133(p $HWNDPARENT, i 1) i.r0'
  System::Call 'dwmapi::DwmSetWindowAttribute(p $HWNDPARENT, i 20, *i 1, i 4)'
  CreateFont $UiFont       "Segoe UI" 10 400
  CreateFont $UiFontBold   "Segoe UI Semibold" 10 600
  CreateFont $UiFontMono   "Cascadia Mono" 9 400
  CreateFont $UiFontTitleSm "Segoe UI Semibold" 22 600
  CreateFont $UiFontEyebrow "Cascadia Mono" 8 400
  SetCtlColors $HWNDPARENT ${COLOR_INK} ${COLOR_BG}
FunctionEnd

Function un.ConfirmCreate
  nsDialogs::Create 1018
  Pop $PageDialog
  ${If} $PageDialog == error
    Abort
  ${EndIf}
  System::Call 'user32::SetWindowPos(p $PageDialog, p 0, i 0, i 0, i 1064, i 676, i 0x0014)'
  SetCtlColors $PageDialog ${COLOR_INK} ${COLOR_BG}
  ; Hide the stock buttons; the painted ones below drive the page.
  GetDlgItem $0 $HWNDPARENT 1
  ShowWindow $0 ${SW_HIDE}
  GetDlgItem $0 $HWNDPARENT 2
  ShowWindow $0 ${SW_HIDE}
  GetDlgItem $0 $HWNDPARENT 3
  ShowWindow $0 ${SW_HIDE}
  GetDlgItem $0 $HWNDPARENT 1035
  ShowWindow $0 ${SW_HIDE}

  Push "$PLUGINSDIR\uninstall.bmp"
  Call un.AddBackground

  !insertmacro AOS_TEXT 258 210 548 40 $UiFontTitleSm ${COLOR_INK} ${COLOR_CARD} ${SS_CENTER} "$(AOS_UN_TITLE)"
  !insertmacro AOS_TEXT 258 254 548 24 $UiFont ${COLOR_LIGHT} ${COLOR_CARD} ${SS_CENTER} "$(AOS_UN_SUB)"
  !insertmacro AOS_TEXT 254 320 400 18 $UiFontEyebrow ${COLOR_CYAN} ${COLOR_CARD} 0 "$(AOS_UN_FOLDER)"
  !insertmacro AOS_TEXT 264 358 540 28 $UiFontMono ${COLOR_INK} ${COLOR_BLACK} 0x200 "$INSTDIR"

  !insertmacro AOS_BTN 838 616 96 42 ${COLOR_BLACK} ${COLOR_ORANGE} "$(AOS_BTN_UNINSTALL)" un.OnUnGo
  !insertmacro AOS_BTN 942 616 96 42 ${COLOR_MUTED} ${COLOR_SURFACE} "$(AOS_BTN_CANCEL)" un.OnUnCancel

  System::Call 'user32::SetWindowPos(p $BackgroundControl, p 1, i 0, i 0, i 1064, i 610, i 0x0010)'
  System::Call 'user32::RedrawWindow(p $PageDialog, p 0, p 0, i 0x0181)'
  nsDialogs::Show
FunctionEnd

Function un.AddBackground
  Exch $0
  ${NSD_CreateBitmap} 0 0 100% 100% ""
  Pop $BackgroundControl
  System::Call 'user32::LoadImageW(p 0, w "$0", i 0, i 1064, i 610, i 0x0010) p.r1'
  StrCpy $BackgroundHandle $1
  SendMessage $BackgroundControl 0x0172 0 $BackgroundHandle
  Pop $0
FunctionEnd

Function un.InstFilesPre
  ; Nothing to press while files are being removed.
FunctionEnd

Function un.InstFilesShow
  ; Same treatment as the installer's progress page: find the inner dialog by
  ; class (the custom page before it leaves a stale id-1018 child behind), size
  ; it to the window and recolour the stock controls.
  FindWindow $PageDialog "#32770" "" $HWNDPARENT
  System::Call 'user32::SetWindowPos(p $PageDialog, p 0, i 0, i 0, i 1064, i 676, i 0x0014)'
  SetCtlColors $PageDialog ${COLOR_INK} ${COLOR_BG}
  GetDlgItem $0 $HWNDPARENT 1
  ShowWindow $0 ${SW_HIDE}
  GetDlgItem $0 $HWNDPARENT 2
  ShowWindow $0 ${SW_HIDE}
  GetDlgItem $0 $HWNDPARENT 3
  ShowWindow $0 ${SW_HIDE}
  GetDlgItem $0 $HWNDPARENT 1035
  ShowWindow $0 ${SW_HIDE}

  GetDlgItem $0 $PageDialog 1004
  System::Call 'user32::SetWindowPos(p $0, p 0, i 250, i 210, i 564, i 30, i 0x0014)'
  SendMessage $0 ${PBM_SETBARCOLOR} 0 0x002257FF
  SendMessage $0 ${PBM_SETBKCOLOR} 0 0x000E0E0E
  GetDlgItem $0 $PageDialog 1006
  System::Call 'user32::SetWindowPos(p $0, p 0, i 250, i 250, i 564, i 22, i 0x0014)'
  SendMessage $0 ${WM_SETFONT} $UiFontMono 0
  SetCtlColors $0 ${COLOR_MUTED} ${COLOR_BG}
  GetDlgItem $0 $PageDialog 1016
  System::Call 'user32::SetWindowPos(p $0, p 0, i 250, i 290, i 564, i 230, i 0x0014)'
  SendMessage $0 ${WM_SETFONT} $UiFontMono 0
  SetCtlColors $0 ${COLOR_INK} ${COLOR_BLACK}
  GetDlgItem $0 $PageDialog 1027
  ShowWindow $0 ${SW_HIDE}
  GetDlgItem $0 $PageDialog 1002
  ShowWindow $0 ${SW_HIDE}
FunctionEnd

Function un.DoneCreate
  nsDialogs::Create 1018
  Pop $PageDialog
  ${If} $PageDialog == error
    Abort
  ${EndIf}
  System::Call 'user32::SetWindowPos(p $PageDialog, p 0, i 0, i 0, i 1064, i 676, i 0x0014)'
  SetCtlColors $PageDialog ${COLOR_INK} ${COLOR_BG}
  GetDlgItem $0 $HWNDPARENT 1
  ShowWindow $0 ${SW_HIDE}
  GetDlgItem $0 $HWNDPARENT 2
  ShowWindow $0 ${SW_HIDE}
  GetDlgItem $0 $HWNDPARENT 3
  ShowWindow $0 ${SW_HIDE}

  Push "$PLUGINSDIR\uninstall-done.bmp"
  Call un.AddBackground

  !insertmacro AOS_TEXT 258 210 548 40 $UiFontTitleSm ${COLOR_INK} ${COLOR_CARD} ${SS_CENTER} "$(AOS_UN_DONE_TITLE)"
  !insertmacro AOS_TEXT 258 258 548 48 $UiFont ${COLOR_LIGHT} ${COLOR_CARD} ${SS_CENTER} "$(AOS_UN_DONE_SUB)"
  !insertmacro AOS_BTN 942 616 96 42 ${COLOR_BLACK} ${COLOR_ORANGE} "$(AOS_BTN_FINISH)" un.OnUnDone

  System::Call 'user32::SetWindowPos(p $BackgroundControl, p 1, i 0, i 0, i 1064, i 610, i 0x0010)'
  System::Call 'user32::RedrawWindow(p $PageDialog, p 0, p 0, i 0x0181)'
  nsDialogs::Show
FunctionEnd

; `Quit` cannot be used from an nsDialogs click handler: the handler runs inside
; the modal loop of nsDialogs::Show, so Quit only raises NSIS' internal quit flag
; and returns - and that flag is not read until Show returns, which never happens
; because nothing closed the dialog. The button looked dead. Routing through the
; real command (WM_COMMAND 1 = Next, and this is the last page, so it closes)
; tears the dialog down the normal way, exactly like the installer's Finish.
Function un.OnUnDone
  Pop $0
  SendMessage $HWNDPARENT ${WM_COMMAND} 1 0
FunctionEnd

Function un.OnUnGo
  Pop $0
  SendMessage $HWNDPARENT ${WM_COMMAND} 1 0
FunctionEnd

; Same trap as un.OnUnDone - this button was dead for the same reason.
; WM_COMMAND 2 = Cancel, which aborts the uninstall the way Esc and the title
; bar X already do.
Function un.OnUnCancel
  Pop $0
  SendMessage $HWNDPARENT ${WM_COMMAND} 2 0
FunctionEnd

Function un.onInit
  InitPluginsDir
  System::Call 'uxtheme::#135(i 2) i.r0'
  SetOutPath "$PLUGINSDIR"
  File "/oname=uninstall.bmp"      "${UI_ASSETS}\uninstall.bmp"
  File "/oname=uninstall-done.bmp" "${UI_ASSETS}\uninstall-done.bmp"
  ReadRegStr $0 HKCU "Software\${APP_NAME}" "InstallerLanguage"
  ${If} $0 != ""
    StrCpy $LANGUAGE "$0"
  ${EndIf}
FunctionEnd




















